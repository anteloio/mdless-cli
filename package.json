{
  "name": "@mdless/cli",
  "version": "0.0.0-development",
  "description": "Mind less, ship more. Agent loops from md files.",
  "type": "module",
  "bin": {
    "mdless": "dist/index.js"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build src/index.ts --target node --format esm --outfile dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "sh scripts/smoke-test.sh",
    "prepack": "bun run build"
  },
  "files": [
    "dist/",
    "src/agents/prompts/",
    "assets/*.mp3"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "keywords": [
    "cli",
    "interactive",
    "prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anteloio/mdless-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@types/bun": "^1.3.8",
    "commander": "^14.0.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
